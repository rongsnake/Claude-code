# ~/.config/systemd/user/energy-api.service — API behind Caddy at /energy/api/
[Unit]
Description=Auto Smart Mode API (uvicorn :5056)
After=network-online.target

[Service]
WorkingDirectory=%h/Claude-code/energy/alstin
ExecStart=/usr/bin/python3 -m uvicorn smart_mode_api:app --host 127.0.0.1 --port 5056
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
